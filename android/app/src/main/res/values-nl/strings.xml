    <!-- Eerste gebruik, privacy, instellingen, Over (guiDesign D-04 tot D-07, D-44; FR-GEN-05 tot 08, FR-DATA-07). -->
    <string name="welcome_version">versie %s</string>
    <string name="intro_title">Zo werkt het</string>
    <string name="intro_leader">Eén telefoon is de kampvuurleider. De leider kiest de liederen en stuurt de tekst via Bluetooth naar alle telefoons in de buurt. Internet is daarvoor niet nodig.</string>
    <string name="intro_singer">De anderen zingen mee: open de app en tik op het kampvuur in de lijst, of scan de QR-code van de leider met je camera. De tekst verschijnt vanzelf.</string>
    <string name="intro_songs">Liederen komen uit bibliotheken die je toevoegt in de Zangbundel. Om mee te zingen heb je er geen nodig: de leider stuurt elk lied.</string>
    <string name="intro_privacy">Wat gebeurt er met mijn gegevens?</string>
    <string name="intro_start">Beginnen</string>
    <string name="privacy_title">Je gegevens</string>
    <string name="privacy_sends_title">Wat de app verstuurt</string>
    <string name="privacy_sends">Alleen tijdens een kampvuur, via Bluetooth: het kampvuur en de liedteksten. Een naam of een verzoek kan alleen de kampvuurleider lezen. Er wordt niets naar de makers of iemand anders verstuurd: geen accountgegevens en geen reclame. Ook word je niet gevolgd.</string>
    <string name="privacy_internet_title">Verbinding met het internet</string>
    <string name="privacy_internet">Alleen om een bibliotheek of setlist te downloaden van de url die jij opgeeft of kiest. Die website ziet jouw download en het internetadres van de wifi of de provider waarmee je online bent.</string>
    <string name="privacy_keeps_title">Wat op je telefoon blijft</string>
    <string name="privacy_keeps">Bibliotheken, setlists, instellingen en de herinneringen. De liedteksten van de leider worden gewist na het kampvuur. Als je leidt en statistieken aanzet, ook een overzicht van elk kampvuur zonder namen; dat gaat alleen van je telefoon af als je het zelf deelt.</string>
    <string name="privacy_delete_title">Hoe je wist wat op je telefoon blijft</string>
    <string name="privacy_delete">Met Alle gegevens verwijderen in Instellingen wis je alles. Je kunt ook per onderdeel wissen, of de app verwijderen.</string>
    <string name="privacy_location_title">Locatie</string>
    <string name="privacy_location">Die wordt nooit uitgelezen. Op Android 11 en ouder vraagt de app die toestemming alleen omdat zoeken naar Bluetooth-apparaten daar die toestemming nodig heeft.</string>
