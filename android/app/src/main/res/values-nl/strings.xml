    <string name="settings_singing">Zingen</string>
    <string name="settings_name">Naam voor de leider</string>
    <string name="settings_name_hint">Alleen je voornaam of bijnaam</string>
    <string name="settings_name_note">Niet verplicht. Alleen de leider ziet hem. Zonder naam ben je een zanger met een nummer. Een wijziging geldt vanaf de volgende keer dat je meezingt.</string>
