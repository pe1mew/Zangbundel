    <!-- First use, privacy, settings, About (guiDesign D-04 to D-07, D-44; FR-GEN-05 to 08, FR-DATA-07). -->
    <string name="welcome_version">version %s</string>
    <string name="intro_title">How it works</string>
    <string name="intro_leader">One phone is the campfire leader. The leader picks the songs and sends the lyrics over Bluetooth to every phone nearby. No internet is needed for that.</string>
    <string name="intro_singer">Everyone else sings along: open the app and tap the campfire in the list, or scan the QR code of the leader with your camera. The lyrics appear by themselves.</string>
    <string name="intro_songs">Songs come from libraries you add in the Songbook. To sing along you need none: the leader sends each song.</string>
    <string name="intro_privacy">What happens to my data?</string>
    <string name="intro_start">Start</string>
    <string name="privacy_title">Your data</string>
    <string name="privacy_sends_title">What the app sends</string>
    <string name="privacy_sends">Only during a campfire, and only to phones nearby over Bluetooth: the campfire itself and the lyrics. If you type a name for the leader or ask for a song, only the phone of the leader can read that: it is locked for the leader.</string>
    <string name="privacy_never_title">What the app never sends</string>
    <string name="privacy_never">Nothing about you to the makers of the app, or to anyone else. No account, no adverts, no tracking.</string>
    <string name="privacy_internet_title">Internet</string>
    <string name="privacy_internet">Only to download a song library or a setlist from an address you enter or choose, and only when you tap. The website you download from sees the internet address of your phone, as with any download.</string>
    <string name="privacy_keeps_title">What stays on your phone</string>
    <string name="privacy_keeps">The libraries and setlists you add, your settings, and for each campfire a memory with its name, date and the titles that were sung. The lyrics the leader sent are deleted when the campfire ends.</string>
    <string name="privacy_delete_title">How to delete it</string>
    <string name="privacy_delete">In Settings, Remove all data deletes everything. You can also delete libraries, setlists and memories one by one, or remove the app.</string>
    <string name="privacy_location_title">Location</string>
    <string name="privacy_location">The app never reads where you are. On Android 11 and older, Android only lets an app find Bluetooth devices with the location permission, so the app asks for it there, for that reason only.</string>
